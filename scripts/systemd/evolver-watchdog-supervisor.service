[Unit]
Description=Evolver Watchdog Supervisor (double-insurance layer 2)
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash /home/wszmd520520/.openclaw/workspace/scripts/evolver-watchdog-supervisor.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/wszmd520520/.openclaw/workspace/logs/evolver-watchdog-supervisor.log
StandardError=append:/home/wszmd520520/.openclaw/workspace/logs/evolver-watchdog-supervisor.log

[Install]
WantedBy=default.target
